{
  "name": "setsnap",
  "private": true,
  "type": "module",
  "description": "Convierte setlists (texto o foto) en playlists de Spotify.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "dev": "npm run build:css && wrangler pages dev public --kv RATE_LIMIT_KV --ip 127.0.0.1 --port 8788",
    "start": "npm run dev",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "wrangler": "^4.0.0"
  }
}
