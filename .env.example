# Spotify (obligatorio para crear playlists)
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback/spotify

# Sesión (cambiar en producción)
SESSION_SECRET=genera-un-secreto-aleatorio-seguro

# Umbrales de matching (opcional; por defecto: 85 y 50)
# AUTO_ACCEPT_THRESHOLD=85
# MANUAL_THRESHOLD=50

# Gemini - extracción de setlist desde imagen (opcional)
# Obtén la API key en https://aistudio.google.com/
# GEMINI_API_KEY=tu_api_key
